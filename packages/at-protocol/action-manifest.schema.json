{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://augusttrung.com/schemas/at-actions.v1.json",
  "title": "AT Action Manifest",
  "type": "object",
  "required": ["protocolVersion", "appId", "appName", "actions"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "at-actions.v1"
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "appVersion": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "route": {
          "type": "string"
        },
        "inputSchema": {
          "type": "object"
        },
        "risk": {
          "enum": ["safe", "confirm", "dangerous"],
          "default": "safe"
        },
        "requiresConfirm": {
          "type": "boolean",
          "default": false
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "navigate",
              "clipboard",
              "download",
              "network",
              "local-storage",
              "user-data"
            ]
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  }
}
