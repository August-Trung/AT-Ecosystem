{
  "Cors": {
    "Origins": [
      "https://hub.example.com"
    ]
  },
  "ShortUrl": {
    "Domain": "https://hub.example.com"
  },
  "Auth": {
    "FrontendOAuthSuccessUrl": "https://hub.example.com/auth/callback"
  },
  "AuthProviders": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_WEB_CLIENT_ID"
    },
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
      "RedirectUri": "https://api.hub.example.com/api/auth/github/callback"
    },
    "Phone": {
      "OtpLength": 6,
      "OtpExpiryMinutes": 5,
      "ExposeOtpInDevelopment": false
    }
  },
  "Security": {
    "EnforceHttps": true,
    "EnableHsts": true,
    "ExposeSwagger": false,
    "ForwardedHeadersEnabled": true,
    "DataProtectionKeysPath": "Storage\\DataProtectionKeys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
