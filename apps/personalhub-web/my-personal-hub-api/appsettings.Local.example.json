{
  "ConnectionStrings": {
    "SqlServer": "Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SQL_SERVER;Database=db_MyFileHub;Trusted_Connection=Yes;Encrypt=No;TrustServerCertificate=Yes;"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "ShortUrl": {
    "Domain": "http://localhost:5000"
  },
  "Auth": {
    "FrontendOAuthSuccessUrl": "http://localhost:3000/auth/callback"
  },
  "AuthProviders": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_WEB_CLIENT_ID"
    },
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
      "RedirectUri": "http://localhost:5000/api/auth/github/callback"
    },
    "Phone": {
      "OtpLength": 6,
      "OtpExpiryMinutes": 5,
      "ExposeOtpInDevelopment": true
    }
  },
  "GoogleDrive": {
    "CredentialsPath": "credentials.json",
    "TokenPath": "Storage\\GoogleDriveToken",
    "FolderId": "YOUR_GOOGLE_DRIVE_FOLDER_ID",
    "ApplicationName": "My Personal Hub"
  },
  "Security": {
    "EnforceHttps": false,
    "EnableHsts": false,
    "ExposeSwagger": true,
    "ForwardedHeadersEnabled": false,
    "DataProtectionKeysPath": "Storage\\DataProtectionKeys"
  }
}
