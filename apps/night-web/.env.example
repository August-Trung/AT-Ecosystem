# Môi trường kết nối cơ sở dữ liệu cho Midnight Pixel Chat

# --- CẤU HÌNH SUPABASE ---
# Lấy thông tin này từ Supabase Project Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- CẤU HÌNH GITHUB GIST (LỰA CHỌN THAY THẾ) ---
# Điền Token và Gist ID nếu bạn muốn sử dụng Gist để lưu trữ thay vì Supabase
VITE_GIST_TOKEN=
VITE_GIST_ID=
