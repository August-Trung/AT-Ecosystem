# Môi trường kết nối cơ sở dữ liệu cho Midnight Pixel Chat

# --- CẤU HÌNH SUPABASE ---
# Lấy thông tin này từ Supabase Project Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- CẤU HÌNH GITHUB GIST (LỰA CHỌN THAY THẾ) ---
# Điền Token và Gist ID nếu bạn muốn sử dụng Gist để lưu trữ thay vì Supabase
VITE_GIST_TOKEN=
VITE_GIST_ID=

# --- CẤU HÌNH BẢO MẬT BYPASS GIỜ MỞ CỬA ---
# Mã bí mật giúp Admin truy cập vào sảnh lofi bất kể giờ giấc (Ví dụ: VITE_ADMIN_BYPASS_TOKEN=my_secret_key)
# Bỏ trống nếu không muốn dùng tính năng này.
VITE_ADMIN_BYPASS_TOKEN=
